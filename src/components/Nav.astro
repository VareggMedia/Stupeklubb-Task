---
import DiveMark from './DiveMark.astro';
const links = [
  { href: '#oppdraget', label: 'Oppdraget' },
  { href: '#hvorfor', label: 'Hvorfor dette' },
  { href: '#problemene', label: 'Problemene' },
  { href: '#teknologi', label: 'Teknologi' },
  { href: '#modulene', label: 'Modulene' },
  { href: '#tips', label: 'Tips & ressurser' },
  { href: '#levering', label: 'Levering' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-pool-950/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="#top" class="flex items-center gap-2 font-display text-lg font-bold text-white">
      <DiveMark class="h-5 w-5 text-splash-400" />
      Stupeklubb<span class="text-splash-400">.oppdrag</span>
    </a>
    <ul class="hidden gap-6 text-sm font-medium text-pool-200 md:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition hover:text-white">{link.label}</a>
        </li>
      ))}
    </ul>
    <a
      href="#modulene"
      class="rounded-full bg-splash-500 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-splash-500/20 transition hover:bg-splash-400"
    >
      Start modul 1 →
    </a>
  </nav>
</header>
