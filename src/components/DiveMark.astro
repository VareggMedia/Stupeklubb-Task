  <circle cx="12" cy="5.5" r="2.25" fill="currentColor" />
  <path
    d="M4 14c2-2 4-2 6 0s4 2 6 0s4-2 6 0"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
  />
  <path
    d="M4 18.5c2-2 4-2 6 0s4 2 6 0s4-2 6 0"
    stroke="currentColor"
