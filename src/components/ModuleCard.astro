---
interface Link {
  label: string;
  href: string;
}

interface Props {
  n: string;
  title: string;
  depth: string;
  problem: string;
  tech: string;
  oppgave: string;
  leveranse: string;
  hints: string[];
  links: Link[];
  open?: boolean;
}

const { n, title, depth, problem, tech, oppgave, leveranse, hints, links, open = false } = Astro.props;
---

<details class="card group overflow-hidden" open={open}>
  <summary class="flex cursor-pointer list-none items-center gap-4 p-6 select-none">
    <span
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-pool-700 font-display text-sm font-bold text-white"
    >
      {n}
    </span>
    <span class="flex-1 font-display text-lg font-semibold text-white">{title}</span>
    <span
      class="hidden shrink-0 rounded-full border border-pool-400/30 bg-pool-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-pool-300 sm:inline-block"
    >
      {depth}
    </span>
    <svg
      class="chev h-5 w-5 shrink-0 text-pool-300 transition-transform duration-200"
      fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </summary>

  <div class="space-y-5 border-t border-white/10 px-6 pb-7 pt-5">
    <p class="text-sm text-pool-300">
      <span class="font-semibold text-splash-400">Problemet dere løser:</span> {problem}
    </p>
    <p class="text-sm text-pool-300">
      <span class="font-semibold text-splash-400">Teknologi:</span> {tech}
    </p>
    <p class="text-sm text-pool-300">
      <span class="font-semibold text-splash-400">Oppgave:</span> {oppgave}
    </p>
    <p class="text-sm text-pool-300">
      <span class="font-semibold text-splash-400">Leveranse:</span> {leveranse}
    </p>

    <div class="rounded-xl border border-pool-500/30 bg-pool-500/[0.08] p-4">
      <p class="text-sm font-semibold text-pool-100">Hint & tips</p>
      <ul class="mt-2 space-y-1.5 text-sm text-pool-200">
        {hints.map((h) => (
          <li class="flex gap-2">
            <span class="text-pool-400">›</span>
            <span set:html={h} />
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-wrap gap-2">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-medium text-pool-100 transition hover:border-splash-400/50 hover:text-white"
        >
          {l.label}
          <svg class="h-3 w-3 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H9M17 7v8" />
          </svg>
        </a>
      ))}
    </div>
  </div>
</details>
