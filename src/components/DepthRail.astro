---
const marks = [
  { pct: 2, label: '0 m', sub: 'Overflaten' },
  { pct: 30, label: '3 m', sub: 'Problemene' },
  { pct: 62, label: '6 m', sub: 'Byggingen' },
  { pct: 95, label: '10 m', sub: 'Stupebrettet' },
];
---

<aside class="pointer-events-none fixed left-6 top-0 z-40 hidden h-screen xl:block" aria-hidden="true">
  <div class="relative mx-auto h-[70vh] w-px translate-y-[15vh] bg-white/10">
    {
      marks.map((m) => (
        <div class="absolute -left-1.5 flex items-center gap-2" style={`top:${m.pct}%`}>
          <span class="h-3 w-3 rounded-full border border-pool-300/50 bg-pool-950" />
          <span class="whitespace-nowrap text-[10px] font-medium uppercase tracking-wider text-pool-400">
            {m.label} · {m.sub}
          </span>
        </div>
      ))
    }
    <div
      id="depth-diver"
      class="absolute -left-[5px] -translate-y-1/2 transition-[top] duration-150 ease-out"
      style="top:2%"
    >
      <span class="relative flex h-3.5 w-3.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-splash-400 opacity-60">
        </span>
        <span class="relative inline-flex h-3.5 w-3.5 rounded-full bg-splash-400"></span>
      </span>
    </div>
  </div>
</aside>

<script>
  const diver = document.getElementById('depth-diver');

  function updateDepth() {
    if (!diver) return;
    const scrollTop = window.scrollY;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const fraction = max > 0 ? Math.min(1, Math.max(0, scrollTop / max)) : 0;
    diver.style.top = `${fraction * 100}%`;
  }

  document.addEventListener('scroll', updateDepth, { passive: true });
  window.addEventListener('resize', updateDepth);
  updateDepth();
</script>
