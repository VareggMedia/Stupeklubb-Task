---
interface Props {
  bgClass: string;
  fillClass: string;
  flip?: boolean;
}

const { bgClass, fillClass, flip = false } = Astro.props;
---

<div class={`relative h-12 w-full overflow-hidden sm:h-20 ${bgClass}`} aria-hidden="true">
  <svg
    class={`absolute inset-0 h-full w-full ${flip ? 'scale-y-[-1]' : ''}`}
    viewBox="0 0 1440 100"
    preserveAspectRatio="none"
  >
    <path class={fillClass} d="M0,40 C240,85 480,0 720,40 C960,80 1200,10 1440,45 L1440,100 L0,100 Z" />
  </svg>
</div>
